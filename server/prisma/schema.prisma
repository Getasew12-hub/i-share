generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum VendorLifecycleStage {
  REGISTERED
  EMAIL_VERIFICATION
  BUSINESS_PROFILE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum VendorVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VendorStatus {
  DRAFT
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum VendorSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  UPGRADED
  DOWNGRADED
}

enum PricingModel {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
  SUSPENDED
  ARCHIVED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum VendorDocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  OWNER_ID
  ADDRESS_PROOF
  OTHER
}

enum VendorDocumentReviewStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum AvailabilityPeriodType {
  AVAILABLE
  RESERVED
  MAINTENANCE
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  ACTIVE
  COMPLETED
}

enum PaymentProvider {
  CHAPA
  STRIPE
  PAYPAL
  TELEBIRR
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum RentalStatus {
  CONFIRMED
  PAID
  ACTIVE
  IN_PROGRESS
  RETURNED
  COMPLETED
  CANCELLED
}

enum DamageReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REPORTED
}

enum NotificationType {
  ACCOUNT_VERIFICATION
  BOOKING_REQUEST
  BOOKING_APPROVAL
  BOOKING_REJECTION
  PAYMENT_CONFIRMATION
  RENTAL_REMINDER
  RETURN_REMINDER
  SUBSCRIPTION_EXPIRATION
  NEW_MESSAGE
  SYSTEM_ANNOUNCEMENT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ConversationType {
  DIRECT
  BOOKING
  DISPUTE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  STATUS_CHANGE
  APPROVE
  REJECT
  PAYMENT_EVENT
  SYSTEM
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String?    @map("password_hash")
  role            UserRole
  status          UserStatus @default(ACTIVE)
  firstName       String?    @map("first_name") @db.VarChar(100)
  lastName        String?    @map("last_name") @db.VarChar(100)
  phoneNumber     String?    @map("phone_number") @db.VarChar(40)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs                  AuditLog[]                @relation("AuditActor")
  conversationParticipants   ConversationParticipant[]
  customerProfile            CustomerProfile?
  disputeMessages            DisputeMessage[]
  disputesOpened             Dispute[]                 @relation("DisputeOpenedBy")
  messages                   Message[]
  notifications              Notification[]
  refreshSessions            RefreshSession[]
  recordedRentalEvents       RentalEvent[]
  reviewedVendorApplications VendorProfile[]           @relation("VendorReviewedBy")
  emailVerificationTokens    EmailVerificationToken[]
  vendorProfile              VendorProfile?

  @@index([role, status])
  @@index([status])
  @@map("users")
}

model RefreshSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  rotatedFromId String?   @unique @map("rotated_from_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(120)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  ipAddress     String?   @map("ip_address") @db.VarChar(80)
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  rotatedFrom RefreshSession? @relation("RefreshSessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   RefreshSession? @relation("RefreshSessionRotation")
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model VendorProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  businessName       String?                  @map("business_name") @db.VarChar(200)
  displayName        String                   @map("display_name") @db.VarChar(200)
  businessEmail      String?                  @map("business_email") @db.VarChar(320)
  businessPhone      String?                  @map("business_phone") @db.VarChar(40)
  taxIdentifier      String?                  @map("tax_identifier") @db.VarChar(100)
  description        String?
  websiteUrl         String?                  @map("website_url")
  country            String?                  @db.VarChar(80)
  city               String?                  @db.VarChar(120)
  addressLine1       String?                  @map("address_line_1")
  addressLine2       String?                  @map("address_line_2")
  lifecycleStage     VendorLifecycleStage     @default(REGISTERED) @map("lifecycle_stage")
  verificationStatus VendorVerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  status             VendorStatus             @default(DRAFT)
  rejectionReason    String?                  @map("rejection_reason")
  submittedAt        DateTime?                @map("submitted_at") @db.Timestamptz(6)
  approvedAt         DateTime?                @map("approved_at") @db.Timestamptz(6)
  rejectedAt         DateTime?                @map("rejected_at") @db.Timestamptz(6)
  reviewedById       String?                  @map("reviewed_by_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings      Booking[]
  documents     VendorDocument[]
  products      Product[]
  reviewedBy    User?                @relation("VendorReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviews       Review[]
  subscriptions VendorSubscription[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([verificationStatus])
  @@index([lifecycleStage])
  @@map("vendor_profiles")
}

model CustomerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(200)
  phoneNumber String?  @map("phone_number") @db.VarChar(40)
  country     String?  @db.VarChar(80)
  city        String?  @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bookings Booking[]
  reviews  Review[]
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([city])
  @@map("customer_profiles")
}

model VendorDocument {
  id           String                     @id @default(uuid()) @db.Uuid
  vendorId     String                     @map("vendor_id") @db.Uuid
  documentType VendorDocumentType         @default(OTHER) @map("document_type")
  reviewStatus VendorDocumentReviewStatus @default(SUBMITTED) @map("review_status")
  fileName     String                     @map("file_name")
  storageKey   String                     @map("storage_key")
  url          String?
  mimeType     String                     @map("mime_type") @db.VarChar(120)
  fileSize     Int                        @map("file_size")
  visibility   FileVisibility             @default(PRIVATE)
  metadata     Json?
  submittedAt  DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([reviewStatus])
  @@map("vendor_documents")
}

model SubscriptionPlan {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String                 @unique @db.VarChar(120)
  description        String?
  status             SubscriptionPlanStatus @default(ACTIVE)
  monthlyPriceAmount Decimal                @map("monthly_price_amount") @db.Decimal(12, 2)
  yearlyPriceAmount  Decimal                @map("yearly_price_amount") @db.Decimal(12, 2)
  currency           String                 @default("USD") @db.Char(3)
  maxProducts        Int                    @map("max_products")
  maxEmployees       Int                    @map("max_employees")
  storageCapacityMb  Int                    @map("storage_capacity_mb")
  maxActiveBookings  Int                    @map("max_active_bookings")
  hasPremiumFeatures Boolean                @default(false) @map("has_premium_features")
  hasAnalytics       Boolean                @default(false) @map("has_analytics")
  metadata           Json?
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions VendorSubscription[]

  @@index([status])
  @@map("subscription_plans")
}

model VendorSubscription {
  id                     String                   @id @default(uuid()) @db.Uuid
  vendorId               String                   @map("vendor_id") @db.Uuid
  planId                 String                   @map("plan_id") @db.Uuid
  status                 VendorSubscriptionStatus @default(PENDING)
  billingCycle           BillingCycle             @map("billing_cycle")
  startsAt               DateTime                 @map("starts_at") @db.Timestamptz(6)
  endsAt                 DateTime                 @map("ends_at") @db.Timestamptz(6)
  cancelledAt            DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  previousSubscriptionId String?                  @map("previous_subscription_id") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  nextSubscriptions    VendorSubscription[] @relation("SubscriptionHistory")
  payments             Payment[]
  plan                 SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  previousSubscription VendorSubscription?  @relation("SubscriptionHistory", fields: [previousSubscriptionId], references: [id], onDelete: SetNull)
  vendor               VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([status, endsAt])
  @@index([planId])
  @@map("vendor_subscriptions")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  name      String     @db.VarChar(120)
  slug      String     @unique @db.VarChar(140)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  children Category[] @relation("CategoryTree")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  vendorId          String        @map("vendor_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  name              String        @db.VarChar(200)
  slug              String        @unique @db.VarChar(240)
  description       String
  pricingModel      PricingModel  @map("pricing_model")
  hourlyRate        Decimal?      @map("hourly_rate") @db.Decimal(12, 2)
  dailyRate         Decimal?      @map("daily_rate") @db.Decimal(12, 2)
  weeklyRate        Decimal?      @map("weekly_rate") @db.Decimal(12, 2)
  monthlyRate       Decimal?      @map("monthly_rate") @db.Decimal(12, 2)
  currency          String        @default("USD") @db.Char(3)
  securityDeposit   Decimal       @default(0) @map("security_deposit") @db.Decimal(12, 2)
  deliveryAvailable Boolean       @default(false) @map("delivery_available")
  deliveryCharge    Decimal       @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  city              String?       @db.VarChar(120)
  country           String?       @db.VarChar(80)
  specifications    Json?
  rentalPolicies    Json?         @map("rental_policies")
  metadata          Json?
  status            ProductStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  availabilityPeriods ProductAvailabilityPeriod[]
  bookings            Booking[]
  category            Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  documents           ProductDocument[]
  images              ProductImage[]
  reviews             Review[]
  vendor              VendorProfile               @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([status])
  @@index([city])
  @@index([pricingModel])
  @@map("products")
}

model ProductImage {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  fileName   String         @map("file_name")
  storageKey String         @map("storage_key")
  url        String
  mimeType   String         @map("mime_type") @db.VarChar(120)
  fileSize   Int            @map("file_size")
  sortOrder  Int            @default(0) @map("sort_order")
  altText    String?        @map("alt_text")
  visibility FileVisibility @default(PUBLIC)
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductDocument {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  fileName   String         @map("file_name")
  storageKey String         @map("storage_key")
  url        String?
  mimeType   String         @map("mime_type") @db.VarChar(120)
  fileSize   Int            @map("file_size")
  visibility FileVisibility @default(PRIVATE)
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_documents")
}

model ProductAvailabilityPeriod {
  id        String                 @id @default(uuid()) @db.Uuid
  productId String                 @map("product_id") @db.Uuid
  type      AvailabilityPeriodType
  startsAt  DateTime               @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime               @map("ends_at") @db.Timestamptz(6)
  reason    String?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@index([productId, startsAt, endsAt])
  @@map("product_availability_periods")
}

model Booking {
  id                   String        @id @default(uuid()) @db.Uuid
  productId            String        @map("product_id") @db.Uuid
  vendorId             String        @map("vendor_id") @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  status               BookingStatus @default(PENDING)
  startsAt             DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime      @map("ends_at") @db.Timestamptz(6)
  rentalDuration       Int           @map("rental_duration")
  pricingModelSnapshot PricingModel  @map("pricing_model_snapshot")
  unitPriceSnapshot    Decimal       @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity             Int           @default(1)
  rentalSubtotal       Decimal       @map("rental_subtotal") @db.Decimal(12, 2)
  deliveryCharge       Decimal       @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  securityDeposit      Decimal       @default(0) @map("security_deposit") @db.Decimal(12, 2)
  promotionalDiscount  Decimal       @default(0) @map("promotional_discount") @db.Decimal(12, 2)
  totalAmount          Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency             String        @default("USD") @db.Char(3)
  cancellationReason   String?       @map("cancellation_reason")
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  rejectedReason       String?       @map("rejected_reason")
  rejectedAt           DateTime?     @map("rejected_at") @db.Timestamptz(6)
  expiresAt            DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation?
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  disputes     Dispute[]
  invoice      Invoice?
  payments     Payment[]
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  rental       Rental?
  vendor       VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([productId, startsAt, endsAt])
  @@index([customerId, status])
  @@index([vendorId, status])
  @@index([status, startsAt])
  @@map("bookings")
}

model Payment {
  id                   String          @id @default(uuid()) @db.Uuid
  bookingId            String?         @map("booking_id") @db.Uuid
  vendorSubscriptionId String?         @map("vendor_subscription_id") @db.Uuid
  provider             PaymentProvider
  methodLabel          String?         @map("method_label") @db.VarChar(120)
  status               PaymentStatus   @default(PENDING)
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("USD") @db.Char(3)
  providerReference    String?         @map("provider_reference")
  transactionId        String?         @map("transaction_id")
  failureCode          String?         @map("failure_code")
  failureMessage       String?         @map("failure_message")
  paidAt               DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking            Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice            Invoice?
  vendorSubscription VendorSubscription? @relation(fields: [vendorSubscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([bookingId, status])
  @@index([vendorSubscriptionId, status])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @unique @map("booking_id") @db.Uuid
  paymentId        String        @unique @map("payment_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(80)
  status           InvoiceStatus @default(ISSUED)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  customerSnapshot Json          @map("customer_snapshot")
  vendorSnapshot   Json          @map("vendor_snapshot")
  productSnapshot  Json          @map("product_snapshot")
  pricingSnapshot  Json          @map("pricing_snapshot")
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency         String        @default("USD") @db.Char(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("invoices")
}

model Rental {
  id                     String       @id @default(uuid()) @db.Uuid
  bookingId              String       @unique @map("booking_id") @db.Uuid
  status                 RentalStatus @default(CONFIRMED)
  pickupDate             DateTime?    @map("pickup_date") @db.Timestamptz(6)
  expectedReturnDate     DateTime     @map("expected_return_date") @db.Timestamptz(6)
  actualReturnDate       DateTime?    @map("actual_return_date") @db.Timestamptz(6)
  isLateReturn           Boolean      @default(false) @map("is_late_return")
  damageNotes            String?      @map("damage_notes")
  additionalCharges      Decimal      @default(0) @map("additional_charges") @db.Decimal(12, 2)
  additionalChargeReason String?      @map("additional_charge_reason")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  damageReports DamageReport[]
  events        RentalEvent[]
  review        Review?

  @@index([status])
  @@index([expectedReturnDate])
  @@map("rentals")
}

model RentalEvent {
  id               String   @id @default(uuid()) @db.Uuid
  rentalId         String   @map("rental_id") @db.Uuid
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  eventType        String   @map("event_type") @db.VarChar(80)
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  notes            String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recordedBy User?  @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  rental     Rental @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  @@index([rentalId, eventType])
  @@index([recordedByUserId])
  @@map("rental_events")
}

model DamageReport {
  id          String             @id @default(uuid()) @db.Uuid
  rentalId    String             @map("rental_id") @db.Uuid
  description String
  charge      Decimal            @default(0) @db.Decimal(12, 2)
  evidence    Json?
  status      DamageReportStatus @default(OPEN)
  reportedAt  DateTime           @default(now()) @map("reported_at") @db.Timestamptz(6)
  resolvedAt  DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  @@index([rentalId])
  @@index([status])
  @@map("damage_reports")
}

model Review {
  id           String       @id @default(uuid()) @db.Uuid
  rentalId     String       @unique @map("rental_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  vendorId     String       @map("vendor_id") @db.Uuid
  customerId   String       @map("customer_id") @db.Uuid
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  reportReason String?      @map("report_reason")
  reportedAt   DateTime?    @map("reported_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  rental   Rental          @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  vendor   VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([customerId, rentalId])
  @@index([vendorId, status])
  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String             @db.VarChar(160)
  body      String?
  payload   Json?
  readAt    DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
  @@map("notifications")
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  bookingId String?          @unique @map("booking_id") @db.Uuid
  type      ConversationType @default(DIRECT)
  subject   String?          @db.VarChar(200)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking?                  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String
  metadata       Json?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  openedByUserId String        @map("opened_by_user_id") @db.Uuid
  reason         String        @db.VarChar(160)
  description    String
  status         DisputeStatus @default(OPEN)
  resolution     String?
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  messages     DisputeMessage[]
  openedByUser User             @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([openedByUserId])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id           String   @id @default(uuid()) @db.Uuid
  disputeId    String   @map("dispute_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  body         String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
  @@index([senderUserId])
  @@map("dispute_messages")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  action       AuditAction
  resourceType String      @map("resource_type") @db.VarChar(120)
  resourceId   String?     @map("resource_id") @db.VarChar(120)
  metadata     Json?
  ipAddress    String?     @map("ip_address") @db.VarChar(80)
  userAgent    String?     @map("user_agent")
  requestId    String?     @map("request_id") @db.VarChar(120)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
